# Copy this file to .env and fill in the values for local development
# Either set DATABASE_URL or set the individual PG* variables below

# Example DATABASE_URL (uncomment and replace values):
# DATABASE_URL=postgresql://username:password@host:5432/databasename

PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# Optional: application port
PORT=5000

# Example for Arcjet key (if used)
# ARCJET_KEY=ajkey_...
# ARCJET_ENV=development
