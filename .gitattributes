# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to LF line endings.
*.js text
*.jsx text
*.css text
*.html text
*.json text
*.md text
*.yml text
*.yaml text
.gitignore text
.gitattributes text
.env.example text